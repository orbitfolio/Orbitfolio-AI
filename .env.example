# All variables are optional. Demo mode works with none of them.
# Yahoo public quotes need no key. Do not commit real secrets.

# Optional 2-sentence rationale via Groq. Template rationale if unset.
GROQ_API_KEY=

# Optional auth. Enables Google/GitHub on /login and session /api/holdings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional shared cache + rate limit (100 req/hour/IP). In-memory + local JSON if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
